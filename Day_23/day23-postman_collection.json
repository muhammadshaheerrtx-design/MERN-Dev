{
  "info": {
    "name": "Day 23 - Auth (JWT & Password Hashing)",
    "_postman_id": "d23-auth-api",
    "description": "Register / Login / Protected route flow for Day 23.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "POST /api/auth/register - 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Raza\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "POST /api/auth/register (duplicate email) - 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Raza\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "POST /api/auth/register (weak password) - 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bad\",\n  \"email\": \"bad@example.com\",\n  \"password\": \"123\"\n}"
        }
      }
    },
    {
      "name": "POST /api/auth/login - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "POST /api/auth/login (wrong password) - 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"wrongpassword\"\n}"
        }
      }
    },
    {
      "name": "GET /api/auth/me (with token) - 200",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "GET /api/auth/me (no token) - 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "GET /api/auth/me (malformed token) - 401",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer not.a.valid.token" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
