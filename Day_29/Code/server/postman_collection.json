{
  "info": {
    "name": "Day 27 - Tasks API (MongoDB backed)",
    "_postman_id": "d27-tasks-db-api",
    "description": "Full CRUD Tasks API secured with JWT auth, now backed by MongoDB Atlas via Mongoose. Covers register/login, protected routes, DB-backed CRUD, and DB-specific error paths (invalid ObjectId, not found).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Raza\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/register (duplicate email) - 400",
